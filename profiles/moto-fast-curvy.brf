# GENERATED FILE - DO NOT EDIT
#
# Source: src/moto-base.brf
# Preset: fast-curvy
# Name: Fast Curvy
# Status: experimental
# Character: fast-curvy
# Curviness: 1
# Hilliness: 0
#

#
# BRouter Motorcycle Profiles
#
# Canonical source profile.
#
# User-facing profiles are generated from this file and config/presets.yaml.
#
# Calibration version:
#   - motorcycle access
#   - one-way restrictions
#   - turn restrictions
#   - barriers
#   - time-aware base routing
#   - road-character / curviness preference
#   - surface handling
#   - town / urban penalty
#   - independent relative hilliness preference
#

---context:global

assign validForCars = true

#
# Primary routing parameters
#

assign curviness = 1
# 0 = fast
# 1 = fast-curvy
# 2 = curvy
# 3 = very-curvy

assign hilliness = 0
# 0 = neutral
# 1 = hilly
# 2 = very-hilly

#
# Independent options
#

assign avoid_motorways = false
assign avoid_toll = false
assign allow_unpaved = false
assign allow_ferries = true

#
# BRouter behaviour
#

assign considerTurnRestrictions = true
assign add_beeline = false
assign processUnusedTags = false

#
# OsmAnd turn instructions
#

assign turnInstructionMode = 3
assign turnInstructionRoundabouts = true

#
# Hilliness model
#

assign uphillcost = 0
assign downhillcost = 0

assign uphillcutoff =
    switch equal hilliness 1 1.5
    switch equal hilliness 2 1.0
    1.5

assign downhillcutoff =
    switch equal hilliness 1 1.5
    switch equal hilliness 2 1.0
    1.5

assign elevationpenaltybuffer = 5
assign elevationmaxbuffer = 10

assign elevationbufferreduce =
    switch equal hilliness 1 0.5
    switch equal hilliness 2 0.75
    0.0


---context:way

#
# Classifier constants
#

assign classifier_none = 1
assign classifier_ferry = 2

#
# Road classifications
#

assign is_motorway =
    highway=motorway

assign is_motorway_link =
    highway=motorway_link

assign is_trunk =
    highway=trunk

assign is_trunk_link =
    highway=trunk_link

assign is_primary =
    highway=primary

assign is_primary_link =
    highway=primary_link

assign is_secondary =
    highway=secondary

assign is_secondary_link =
    highway=secondary_link

assign is_tertiary =
    highway=tertiary

assign is_tertiary_link =
    highway=tertiary_link

assign is_unclassified =
    highway=unclassified

assign is_residential =
    highway=residential

assign is_living =
    or highway=living_street
       living_street=yes

assign is_service =
    highway=service

assign is_track =
    highway=track

assign is_road =
    highway=road

assign is_path =
    highway=path|footway|bridleway

assign is_ferry =
    route=ferry

assign is_residential_or_living =
    or is_residential
       is_living

assign is_link =
    highway=motorway_link|trunk_link|primary_link|secondary_link|tertiary_link

#
# Motorcycle access
#

assign default_motorcycle_access =
    switch highway=motorway|motorway_link       true
    switch highway=trunk|trunk_link             true
    switch highway=primary|primary_link         true
    switch highway=secondary|secondary_link     true
    switch highway=tertiary|tertiary_link       true
    switch highway=unclassified                 true
    switch is_residential_or_living             true
    switch highway=service                      true
    switch route=ferry                          allow_ferries
    switch and highway=track allow_unpaved      true
    switch and highway=road allow_unpaved       true
    false

assign general_access =
    switch access=
        default_motorcycle_access
        access=yes|permissive|designated|destination

assign vehicle_access =
    switch vehicle=
        general_access
        vehicle=yes|permissive|designated|destination

assign motor_vehicle_access =
    switch motor_vehicle=
        vehicle_access
        motor_vehicle=yes|permissive|designated|destination

assign motorcycle_access =
    switch motorcycle=
        motor_vehicle_access
        motorcycle=yes|permissive|designated|destination

assign motorcycle_access_destination =
    switch motorcycle=
        switch motor_vehicle=
            switch vehicle=
                access=destination
                vehicle=destination
            motor_vehicle=destination
        motorcycle=destination

#
# One-way handling
#

assign isbadoneway =
    if reversedirection=yes
    then
        if oneway=
        then junction=roundabout
        else oneway=yes|true|1
    else
        oneway=-1

assign isgoodoneway =
    if reversedirection=yes
    then oneway=-1
    else
        if oneway=
        then junction=roundabout
        else oneway=yes|true|1

#
# Surface classification
#

assign surface_is_paved =
    surface=paved|asphalt|concrete|paving_stones|sett

assign surface_is_unpaved =
    surface=unpaved|gravel|fine_gravel|compacted|ground|dirt|earth|grass|sand|mud|clay

assign surface_is_bad =
    surface=grass_paver|pebblestone

assign track_is_paved =
    and is_track
        or surface_is_paved
           tracktype=grade1

assign track_is_unpaved =
    and is_track
        not track_is_paved

#
# Supported-road model
#

assign normal_road_supported =
    or is_motorway
    or is_motorway_link
    or is_trunk
    or is_trunk_link
    or is_primary
    or is_primary_link
    or is_secondary
    or is_secondary_link
    or is_tertiary
    or is_tertiary_link
    or is_unclassified
    or is_residential_or_living
       is_service

assign optional_unpaved_supported =
    and allow_unpaved
        or is_track
           is_road

assign road_is_supported =
    or normal_road_supported
    or optional_unpaved_supported
       is_ferry

assign surface_is_usable =
    if is_ferry
    then true
    else if is_path
    then false
    else if surface_is_unpaved
    then allow_unpaved
    else if surface_is_bad
    then allow_unpaved
    else if track_is_unpaved
    then allow_unpaved
    else true

assign way_is_usable =
    and motorcycle_access
    and road_is_supported
    and surface_is_usable
        not isbadoneway

#
# Ferry handling
#

assign initialclassifier =
    if is_ferry
    then classifier_ferry
    else classifier_none

assign initialcost =
    if not way_is_usable
    then 1000000
    else if is_ferry
    then 10000
    else 0

#
# Turn cost
#

assign turncost =
    if junction=roundabout
    then 0
    else 90

#
# ----------------------------------------------------------------------
# TIME-AWARE BASE MODEL
# ----------------------------------------------------------------------
#

assign maxspeed_forward =
    switch maxspeed:forward=10    10
    switch maxspeed:forward=20    20
    switch maxspeed:forward=30    30
    switch maxspeed:forward=40    40
    switch maxspeed:forward=50    50
    switch maxspeed:forward=60    60
    switch maxspeed:forward=70    70
    switch maxspeed:forward=80    80
    switch maxspeed:forward=90    90
    switch maxspeed:forward=100  100
    switch maxspeed:forward=110  110
    switch maxspeed:forward=120  120
    switch maxspeed:forward=130  130
    switch maxspeed:forward=urban 50
    switch maxspeed:forward=rural 100
    999

assign maxspeed_backward =
    switch maxspeed:backward=10    10
    switch maxspeed:backward=20    20
    switch maxspeed:backward=30    30
    switch maxspeed:backward=40    40
    switch maxspeed:backward=50    50
    switch maxspeed:backward=60    60
    switch maxspeed:backward=70    70
    switch maxspeed:backward=80    80
    switch maxspeed:backward=90    90
    switch maxspeed:backward=100  100
    switch maxspeed:backward=110  110
    switch maxspeed:backward=120  120
    switch maxspeed:backward=130  130
    switch maxspeed:backward=urban 50
    switch maxspeed:backward=rural 100
    999

assign directional_maxspeed =
    if reversedirection=yes
    then maxspeed_backward
    else maxspeed_forward

assign maxspeed_explicit =
    switch maxspeed=10    10
    switch maxspeed=20    20
    switch maxspeed=30    30
    switch maxspeed=40    40
    switch maxspeed=50    50
    switch maxspeed=60    60
    switch maxspeed=70    70
    switch maxspeed=80    80
    switch maxspeed=90    90
    switch maxspeed=100  100
    switch maxspeed=110  110
    switch maxspeed=120  120
    switch maxspeed=130  130
    switch maxspeed=urban 50
    switch maxspeed=rural 100
    directional_maxspeed

#
# Implicit motorcycle travel-speed assumptions
#

assign implicit_speed =
    switch is_motorway              120
    switch is_motorway_link          80
    switch is_trunk                 100
    switch is_trunk_link             70
    switch is_primary                90
    switch is_primary_link           70
    switch is_secondary              80
    switch is_secondary_link         65
    switch is_tertiary               70
    switch is_tertiary_link          60
    switch is_unclassified           60
    switch is_residential            45
    switch is_living                 20
    switch is_service                30
    switch is_ferry                  10
    switch is_track                  20
    switch is_road                   30
    10

#
# Surface speed limits
#

assign surface_speed =
    switch surface=                        999
    switch surface=asphalt|paved|concrete  999
    switch surface=paving_stones|sett       40
    switch surface=cobblestone              30
    switch surface=fine_gravel              25
    switch surface=compacted                25
    switch surface=gravel                   20
    15

#
# Track speed limits
#

assign track_speed =
    switch not is_track        999
    switch tracktype=          20
    switch tracktype=grade1    30
    switch tracktype=grade2    20
    10

#
# Effective speed
#

assign selected_explicit_speed =
    if lesser maxspeed_explicit 999
    then maxspeed_explicit
    else implicit_speed

assign effective_speed =
    min selected_explicit_speed
    min implicit_speed
    min surface_speed
        track_speed

#
# Time-equivalent base cost
#
# 120 km/h -> 1.00
# 100 km/h -> 1.20
#  80 km/h -> 1.50
#  60 km/h -> 2.00
#  50 km/h -> 2.40
#  30 km/h -> 4.00
#

assign time_cost =
    if lesser effective_speed 1
    then 10000
    else max 1.00
             multiply 120
                      divide 1 effective_speed

#
# ----------------------------------------------------------------------
# MOTORCYCLE ROAD CHARACTER / CURVINESS
# ----------------------------------------------------------------------
#
# Calibration:
#
# curviness=1 (Fast Curvy) is deliberately stronger than before.
# It should accept a moderate time penalty for attractive secondary
# and tertiary roads without behaving like the full Curvy profile.
#

assign motorway_character =
    switch equal curviness 0 1.00
    switch equal curviness 1 1.25
    switch equal curviness 2 1.75
    2.60

assign motorway_link_character =
    switch equal curviness 0 1.00
    switch equal curviness 1 1.25
    switch equal curviness 2 1.70
    2.50

assign trunk_character =
    switch equal curviness 0 1.00
    switch equal curviness 1 1.15
    switch equal curviness 2 1.35
    1.70

assign trunk_link_character =
    switch equal curviness 0 1.00
    switch equal curviness 1 1.15
    switch equal curviness 2 1.30
    1.60

assign primary_character =
    switch equal curviness 0 1.00
    switch equal curviness 1 1.03
    switch equal curviness 2 1.12
    1.28

assign primary_link_character =
    switch equal curviness 0 1.00
    switch equal curviness 1 1.03
    switch equal curviness 2 1.12
    1.28

assign secondary_character =
    switch equal curviness 0 1.00
    switch equal curviness 1 0.90
    switch equal curviness 2 0.90
    0.88

assign secondary_link_character =
    switch equal curviness 0 1.00
    switch equal curviness 1 0.94
    switch equal curviness 2 0.94
    0.94

assign tertiary_character =
    switch equal curviness 0 1.00
    switch equal curviness 1 0.88
    switch equal curviness 2 0.88
    0.84

assign tertiary_link_character =
    switch equal curviness 0 1.00
    switch equal curviness 1 0.92
    switch equal curviness 2 0.93
    0.90

assign unclassified_character =
    switch equal curviness 0 1.10
    switch equal curviness 1 0.98
    switch equal curviness 2 0.96
    0.94

#
# Local roads never become more attractive with increasing curviness.
#

assign residential_character =
    switch equal curviness 0 1.30
    switch equal curviness 1 1.35
    switch equal curviness 2 1.50
    1.75

assign living_character =
    switch equal curviness 0 1.80
    switch equal curviness 1 1.90
    switch equal curviness 2 2.20
    2.60

assign service_character =
    switch equal curviness 0 2.00
    switch equal curviness 1 2.10
    switch equal curviness 2 2.40
    2.80

assign track_character = 3.00
assign unknown_road_character = 2.50
assign ferry_character = 1.50

assign selected_road_character =
    if is_motorway
    then motorway_character
    else if is_motorway_link
    then motorway_link_character
    else if is_trunk
    then trunk_character
    else if is_trunk_link
    then trunk_link_character
    else if is_primary
    then primary_character
    else if is_primary_link
    then primary_link_character
    else if is_secondary
    then secondary_character
    else if is_secondary_link
    then secondary_link_character
    else if is_tertiary
    then tertiary_character
    else if is_tertiary_link
    then tertiary_link_character
    else if is_unclassified
    then unclassified_character
    else if is_residential
    then residential_character
    else if is_living
    then living_character
    else if is_service
    then service_character
    else if is_track
    then track_character
    else if is_road
    then unknown_road_character
    else if is_ferry
    then ferry_character
    else 10000

assign character_time_cost =
    multiply time_cost
             selected_road_character

#
# ----------------------------------------------------------------------
# URBAN / TOWN MODIFIER
# ----------------------------------------------------------------------
#

assign town_modifier_fast =
    switch estimated_town_class=  1.00
    switch estimated_town_class=1 1.00
    switch estimated_town_class=2 1.00
    switch estimated_town_class=3 1.01
    switch estimated_town_class=4 1.02
    switch estimated_town_class=5 1.03
    switch estimated_town_class=6 1.04
    1.00

assign town_modifier_fast_curvy =
    switch estimated_town_class=  1.00
    switch estimated_town_class=1 1.00
    switch estimated_town_class=2 1.01
    switch estimated_town_class=3 1.02
    switch estimated_town_class=4 1.04
    switch estimated_town_class=5 1.06
    switch estimated_town_class=6 1.08
    1.00


assign town_modifier_curvy =
    switch estimated_town_class=  1.00
    switch estimated_town_class=1 1.00
    switch estimated_town_class=2 1.01
    switch estimated_town_class=3 1.02
    switch estimated_town_class=4 1.03
    switch estimated_town_class=5 1.05
    switch estimated_town_class=6 1.07
    1.00

assign town_modifier_very_curvy =
    switch estimated_town_class=  1.00
    switch estimated_town_class=1 1.00
    switch estimated_town_class=2 1.01
    switch estimated_town_class=3 1.02
    switch estimated_town_class=4 1.04
    switch estimated_town_class=5 1.06
    switch estimated_town_class=6 1.08
    1.00


assign town_modifier =
    switch equal curviness 0 town_modifier_fast
    switch equal curviness 1 town_modifier_fast_curvy
    switch equal curviness 2 town_modifier_curvy
    town_modifier_very_curvy

#
# Explicit motorway avoidance
#

assign motorway_modifier =
    if and avoid_motorways
           highway=motorway|motorway_link
    then 10000
    else 1.00

#
# Explicit toll avoidance
#

assign toll_modifier =
    if and avoid_toll
           toll=yes
    then 10000
    else 1.00

#
# Core route-character cost
#

assign calculated_cost =
    multiply character_time_cost
    multiply town_modifier
             motorway_modifier

#
# ----------------------------------------------------------------------
# HILLINESS
# ----------------------------------------------------------------------
#
# Hilliness is relative rather than an absolute additive penalty.
#
# Neutral:
#   flat terrain x 1.00
#
# Hilly:
#   flat terrain x 1.10
#
# Very Hilly:
#   flat terrain x 1.20
#
# Uphill/downhill sections do not receive this flat-terrain factor.
#

assign flat_factor =
    switch equal hilliness 1 1.10
    switch equal hilliness 2 1.20
    1.00

#
# Normal / nominal terrain
#

assign costfactor =
    if not way_is_usable
    then 10000
    else if greater toll_modifier 1
    then 10000
    else min 9999
         max 1.00
             multiply calculated_cost
                      flat_factor

#
# Uphill terrain
#

assign uphillcostfactor =
    if not way_is_usable
    then 10000
    else if greater toll_modifier 1
    then 10000
    else min 9999
         max 1.00
             calculated_cost

#
# Downhill terrain
#

assign downhillcostfactor =
    if not way_is_usable
    then 10000
    else if greater toll_modifier 1
    then 10000
    else min 9999
         max 1.00
             calculated_cost

#
# Priority classification for turn instructions
#

assign priorityclassifier =
    if      is_motorway       then 30
    else if is_motorway_link  then 29
    else if is_trunk          then 28
    else if is_trunk_link     then 27
    else if is_primary        then 26
    else if is_primary_link   then 25
    else if is_secondary      then 24
    else if is_secondary_link then 23
    else if is_tertiary       then 22
    else if is_tertiary_link  then 21
    else if is_unclassified   then 20
    else if is_residential_or_living then 6
    else if is_service        then 6
    else if is_track          then 2
    else if is_road           then 2
    else 0

assign isroundabout =
    junction=roundabout

assign isgoodforcars =
    if greater priorityclassifier 6
    then true
    else if or is_residential_or_living
               is_service
    then true
    else false

assign classifiermask =
    add          isbadoneway
    add multiply isgoodoneway   2
    add multiply isroundabout   4
    add multiply is_link        8
    add multiply isgoodforcars 16
        multiply motorcycle_access_destination 64


---context:node

#
# Node access
#

assign default_node_access =
    not barrier=gate|bollard|lift_gate|cycle_barrier

assign general_node_access =
    switch access=
        default_node_access
        access=yes|permissive|designated|destination

assign vehicle_node_access =
    switch vehicle=
        general_node_access
        vehicle=yes|permissive|designated|destination

assign motor_vehicle_node_access =
    switch motor_vehicle=
        vehicle_node_access
        motor_vehicle=yes|permissive|designated|destination

assign motorcycle_node_access =
    switch motorcycle=
        motor_vehicle_node_access
        motorcycle=yes|permissive|designated|destination

assign initialcost =
    if and avoid_toll
           barrier=toll_booth
    then 1000000
    else if motorcycle_node_access
    then 0
    else 1000000
