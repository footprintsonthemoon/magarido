# GENERATED FILE - DO NOT EDIT
#
# Source: src/moto-base.brf
# Preset: fast-curvy
# Name: Fast Curvy
#

#
# BRouter Motorcycle Profiles
#
# Canonical source profile.
#
# User-facing profiles are generated from this file and config/presets.yaml.
#
# Phase 3:
#   - motorcycle access
#   - one-way restrictions
#   - turn restrictions
#   - barriers
#   - road-class suitability
#   - paved / unpaved handling
#   - maxspeed-based road-character modifier
#   - town / urban penalty
#
# Not yet implemented:
#   - hilliness preference
#

---context:global

#
# Profile type
#

assign validForCars = true

#
# Primary routing parameters
#
# Replaced by tools/generate_profiles.py.
#

assign curviness = 1
# 0 = fast
# 1 = fast-curvy
# 2 = curvy
# 3 = very-curvy

assign hilliness = 0
# 0 = neutral
# 1 = hilly
# 2 = very-hilly

#
# Independent options
#

assign avoid_motorways = false
assign avoid_toll = false
assign allow_unpaved = false
assign allow_ferries = true

#
# BRouter behaviour
#

assign considerTurnRestrictions = true
assign add_beeline = false
assign processUnusedTags = false

#
# OsmAnd turn instructions
#

assign turnInstructionMode = 3
assign turnInstructionRoundabouts = true

#
# Elevation
#
# Phase 3 deliberately applies no hilliness preference.
#

assign downhillcost = 0
assign downhillcutoff = 0
assign uphillcost = 0
assign uphillcutoff = 0


---context:way

#
# Classifier constants
#

assign classifier_none = 1
assign classifier_ferry = 2

#
# Basic road classifications
#

assign is_motorway =
    highway=motorway

assign is_motorway_link =
    highway=motorway_link

assign is_trunk =
    highway=trunk

assign is_trunk_link =
    highway=trunk_link

assign is_primary =
    highway=primary

assign is_primary_link =
    highway=primary_link

assign is_secondary =
    highway=secondary

assign is_secondary_link =
    highway=secondary_link

assign is_tertiary =
    highway=tertiary

assign is_tertiary_link =
    highway=tertiary_link

assign is_unclassified =
    highway=unclassified

assign is_residential =
    highway=residential

assign is_living =
    or highway=living_street
       living_street=yes

assign is_service =
    highway=service

assign is_track =
    highway=track

assign is_road =
    highway=road

assign is_path =
    highway=path|footway|bridleway

assign is_ferry =
    route=ferry

assign is_residential_or_living =
    or is_residential
       is_living

assign is_link =
    highway=motorway_link|trunk_link|primary_link|secondary_link|tertiary_link

#
# Motorcycle access
#
# Precedence:
#
# motorcycle
#   -> motor_vehicle
#      -> vehicle
#         -> access
#            -> implicit highway default
#

assign default_motorcycle_access =
    switch highway=motorway|motorway_link       true
    switch highway=trunk|trunk_link             true
    switch highway=primary|primary_link         true
    switch highway=secondary|secondary_link     true
    switch highway=tertiary|tertiary_link       true
    switch highway=unclassified                 true
    switch is_residential_or_living             true
    switch highway=service                      true
    switch route=ferry                          allow_ferries
    switch and highway=track allow_unpaved      true
    switch and highway=road allow_unpaved       true
    false

assign general_access =
    switch access=
        default_motorcycle_access
        access=yes|permissive|designated|destination

assign vehicle_access =
    switch vehicle=
        general_access
        vehicle=yes|permissive|designated|destination

assign motor_vehicle_access =
    switch motor_vehicle=
        vehicle_access
        motor_vehicle=yes|permissive|designated|destination

assign motorcycle_access =
    switch motorcycle=
        motor_vehicle_access
        motorcycle=yes|permissive|designated|destination

#
# Destination-only access metadata
#

assign motorcycle_access_destination =
    switch motorcycle=
        switch motor_vehicle=
            switch vehicle=
                access=destination
                vehicle=destination
            motor_vehicle=destination
        motorcycle=destination

#
# One-way handling
#

assign isbadoneway =
    if reversedirection=yes
    then
        if oneway=
        then junction=roundabout
        else oneway=yes|true|1
    else
        oneway=-1

assign isgoodoneway =
    if reversedirection=yes
    then oneway=-1
    else
        if oneway=
        then junction=roundabout
        else oneway=yes|true|1

#
# Surface classification
#
# BRouter lookups normalise concrete:plates and concrete:lanes
# to surface=concrete.
#

assign surface_is_paved =
    surface=paved|asphalt|concrete|paving_stones|sett

assign surface_is_unpaved =
    surface=unpaved|gravel|fine_gravel|compacted|ground|dirt|earth|grass|sand|mud|clay

assign surface_is_bad =
    surface=grass_paver|pebblestone

#
# Track classification
#

assign track_is_paved =
    and is_track
        or surface_is_paved
           tracktype=grade1

assign track_is_unpaved =
    and is_track
        not track_is_paved

#
# Basic supported-road model
#

assign normal_road_supported =
    or is_motorway
    or is_motorway_link
    or is_trunk
    or is_trunk_link
    or is_primary
    or is_primary_link
    or is_secondary
    or is_secondary_link
    or is_tertiary
    or is_tertiary_link
    or is_unclassified
    or is_residential_or_living
       is_service

assign optional_unpaved_supported =
    and allow_unpaved
        or is_track
           is_road

assign road_is_supported =
    or normal_road_supported
    or optional_unpaved_supported
       is_ferry

#
# Surface eligibility
#
# Missing surface information on ordinary road classes is allowed.
# Explicitly unpaved surfaces are blocked unless allow_unpaved=true.
#

assign surface_is_usable =
    if is_ferry
    then true
    else if is_path
    then false
    else if surface_is_unpaved
    then allow_unpaved
    else if surface_is_bad
    then allow_unpaved
    else if track_is_unpaved
    then allow_unpaved
    else true

#
# Overall way eligibility
#

assign way_is_usable =
    and motorcycle_access
    and road_is_supported
    and surface_is_usable
        not isbadoneway

#
# Ferry classifier
#

assign initialclassifier =
    if is_ferry
    then classifier_ferry
    else classifier_none

#
# Initial transition cost
#

assign initialcost =
    if not way_is_usable
    then 1000000
    else if is_ferry
    then 10000
    else 0

#
# Turn cost
#
# Deliberately constant in Phase 3.
#

assign turncost =
    if junction=roundabout
    then 0
    else 90

#
# Road-class cost model
#
# Curviness 0 = Fast
# Curviness 1 = Fast Curvy
# Curviness 2 = Curvy
# Curviness 3 = Very Curvy
#

assign motorway_cost =
    switch equal curviness 0 1.00
    switch equal curviness 1 1.30
    switch equal curviness 2 3.00
    6.00

assign motorway_link_cost =
    switch equal curviness 0 1.05
    switch equal curviness 1 1.35
    switch equal curviness 2 3.10
    6.10

assign trunk_cost =
    switch equal curviness 0 1.05
    switch equal curviness 1 1.20
    switch equal curviness 2 2.00
    3.50

assign trunk_link_cost =
    switch equal curviness 0 1.10
    switch equal curviness 1 1.25
    switch equal curviness 2 2.10
    3.60

assign primary_cost =
    switch equal curviness 0 1.10
    switch equal curviness 1 1.05
    switch equal curviness 2 1.35
    1.80

assign primary_link_cost =
    switch equal curviness 0 1.15
    switch equal curviness 1 1.10
    switch equal curviness 2 1.40
    1.85

assign secondary_cost =
    switch equal curviness 0 1.20
    switch equal curviness 1 1.05
    switch equal curviness 2 1.00
    1.05

assign secondary_link_cost =
    switch equal curviness 0 1.25
    switch equal curviness 1 1.10
    switch equal curviness 2 1.05
    1.10

assign tertiary_cost =
    switch equal curviness 0 1.35
    switch equal curviness 1 1.10
    switch equal curviness 2 1.00
    1.00

assign tertiary_link_cost =
    switch equal curviness 0 1.40
    switch equal curviness 1 1.15
    switch equal curviness 2 1.05
    1.05

assign unclassified_cost =
    switch equal curviness 0 1.70
    switch equal curviness 1 1.30
    switch equal curviness 2 1.10
    1.05

assign residential_cost =
    switch equal curviness 0 2.50
    switch equal curviness 1 2.50
    switch equal curviness 2 3.00
    4.00

assign living_cost =
    switch equal curviness 0 4.00
    switch equal curviness 1 4.00
    switch equal curviness 2 5.00
    6.00

assign service_cost =
    switch equal curviness 0 5.00
    switch equal curviness 1 5.00
    switch equal curviness 2 6.00
    8.00

assign track_cost =
    if track_is_paved
    then 6.00
    else 12.00

assign road_cost =
    8.00

#
# Select basic road-class cost
#

assign road_class_cost =
    if is_motorway
    then motorway_cost
    else if is_motorway_link
    then motorway_link_cost
    else if is_trunk
    then trunk_cost
    else if is_trunk_link
    then trunk_link_cost
    else if is_primary
    then primary_cost
    else if is_primary_link
    then primary_link_cost
    else if is_secondary
    then secondary_cost
    else if is_secondary_link
    then secondary_link_cost
    else if is_tertiary
    then tertiary_cost
    else if is_tertiary_link
    then tertiary_link_cost
    else if is_unclassified
    then unclassified_cost
    else if is_residential
    then residential_cost
    else if is_living
    then living_cost
    else if is_service
    then service_cost
    else if is_track
    then track_cost
    else if is_road
    then road_cost
    else if is_ferry
    then 5.00
    else 10000

#
# Explicit maxspeed conversion
#
# OSM lookup values are converted to numeric values before use.
# The lookup buckets also contain equivalent values such as:
#
#   maxspeed=50 -> 50, 55, 56, 30 mph
#   maxspeed=60 -> 60, 65, 35/40 mph
#   maxspeed=80 -> 80, 85, 50 mph
#
# This follows the approach used by BRouter car-vario.brf.
#

assign maxspeed_forward =
    switch maxspeed:forward=10    10
    switch maxspeed:forward=20    20
    switch maxspeed:forward=30    30
    switch maxspeed:forward=40    40
    switch maxspeed:forward=50    50
    switch maxspeed:forward=60    60
    switch maxspeed:forward=70    70
    switch maxspeed:forward=80    80
    switch maxspeed:forward=90    90
    switch maxspeed:forward=100  100
    switch maxspeed:forward=110  110
    switch maxspeed:forward=120  120
    switch maxspeed:forward=130  130
    switch maxspeed:forward=urban 50
    switch maxspeed:forward=rural 100
    999

assign maxspeed_backward =
    switch maxspeed:backward=10    10
    switch maxspeed:backward=20    20
    switch maxspeed:backward=30    30
    switch maxspeed:backward=40    40
    switch maxspeed:backward=50    50
    switch maxspeed:backward=60    60
    switch maxspeed:backward=70    70
    switch maxspeed:backward=80    80
    switch maxspeed:backward=90    90
    switch maxspeed:backward=100  100
    switch maxspeed:backward=110  110
    switch maxspeed:backward=120  120
    switch maxspeed:backward=130  130
    switch maxspeed:backward=urban 50
    switch maxspeed:backward=rural 100
    999

assign directional_maxspeed =
    if reversedirection=yes
    then maxspeed_backward
    else maxspeed_forward

assign maxspeed_explicit =
    switch maxspeed=10    10
    switch maxspeed=20    20
    switch maxspeed=30    30
    switch maxspeed=40    40
    switch maxspeed=50    50
    switch maxspeed=60    60
    switch maxspeed=70    70
    switch maxspeed=80    80
    switch maxspeed=90    90
    switch maxspeed=100  100
    switch maxspeed=110  110
    switch maxspeed=120  120
    switch maxspeed=130  130
    switch maxspeed=urban 50
    switch maxspeed=rural 100
    directional_maxspeed

#
# Speed-character modifiers
#
# Important:
#
#   Low speed is NOT treated as curviness.
#
# 30 km/h and below are penalised, particularly for curvy modes,
# because these values commonly indicate residential or urban roads.
#
# 60-80 km/h is treated as the most interesting range for curvy
# motorcycle routing when the basic road class is also suitable.
#
# Missing explicit speed information produces modifier 1.00.
#

assign speed_modifier_fast =
    if lesser maxspeed_explicit 20
    then 1.25
    else if lesser maxspeed_explicit 40
    then 1.18
    else if lesser maxspeed_explicit 60
    then 1.08
    else 1.00

assign speed_modifier_fast_curvy =
    if lesser maxspeed_explicit 20
    then 1.35
    else if lesser maxspeed_explicit 40
    then 1.25
    else if lesser maxspeed_explicit 60
    then 1.08
    else if lesser maxspeed_explicit 90
    then 1.00
    else if lesser maxspeed_explicit 100
    then 1.03
    else if lesser maxspeed_explicit 999
    then 1.08
    else 1.00

assign speed_modifier_curvy =
    if lesser maxspeed_explicit 20
    then 1.50
    else if lesser maxspeed_explicit 40
    then 1.35
    else if lesser maxspeed_explicit 60
    then 1.12
    else if lesser maxspeed_explicit 80
    then 1.00
    else if lesser maxspeed_explicit 90
    then 1.02
    else if lesser maxspeed_explicit 100
    then 1.08
    else if lesser maxspeed_explicit 999
    then 1.18
    else 1.00

assign speed_modifier_very_curvy =
    if lesser maxspeed_explicit 20
    then 1.65
    else if lesser maxspeed_explicit 40
    then 1.50
    else if lesser maxspeed_explicit 60
    then 1.18
    else if lesser maxspeed_explicit 80
    then 1.00
    else if lesser maxspeed_explicit 90
    then 1.03
    else if lesser maxspeed_explicit 100
    then 1.12
    else if lesser maxspeed_explicit 999
    then 1.28
    else 1.00

assign speed_modifier =
    switch equal curviness 0 speed_modifier_fast
    switch equal curviness 1 speed_modifier_fast_curvy
    switch equal curviness 2 speed_modifier_curvy
    speed_modifier_very_curvy

#
# Town / urban modifier
#
# BRouter provides estimated_town_class 1..6.
#
# Curvy profiles penalise increasingly urban surroundings.
# This is deliberately modest because residential/living/service
# roads already receive strong road-class penalties.
#

assign town_modifier_fast =
    switch estimated_town_class=  1.00
    switch estimated_town_class=1 1.00
    switch estimated_town_class=2 1.01
    switch estimated_town_class=3 1.02
    switch estimated_town_class=4 1.03
    switch estimated_town_class=5 1.04
    switch estimated_town_class=6 1.05
    1.00

assign town_modifier_fast_curvy =
    switch estimated_town_class=  1.00
    switch estimated_town_class=1 1.01
    switch estimated_town_class=2 1.02
    switch estimated_town_class=3 1.04
    switch estimated_town_class=4 1.06
    switch estimated_town_class=5 1.08
    switch estimated_town_class=6 1.10
    1.00

assign town_modifier_curvy =
    switch estimated_town_class=  1.00
    switch estimated_town_class=1 1.02
    switch estimated_town_class=2 1.04
    switch estimated_town_class=3 1.07
    switch estimated_town_class=4 1.10
    switch estimated_town_class=5 1.13
    switch estimated_town_class=6 1.16
    1.00

assign town_modifier_very_curvy =
    switch estimated_town_class=  1.00
    switch estimated_town_class=1 1.03
    switch estimated_town_class=2 1.06
    switch estimated_town_class=3 1.10
    switch estimated_town_class=4 1.14
    switch estimated_town_class=5 1.18
    switch estimated_town_class=6 1.22
    1.00

assign town_modifier =
    switch equal curviness 0 town_modifier_fast
    switch equal curviness 1 town_modifier_fast_curvy
    switch equal curviness 2 town_modifier_curvy
    town_modifier_very_curvy

#
# Surface modifier
#

assign surface_modifier =
    if surface=cobblestone
    then 1.40
    else if surface=paving_stones|sett
    then 1.15
    else if surface_is_unpaved
    then 2.00
    else if surface_is_bad
    then 2.00
    else 1.00

#
# Explicit motorway avoidance
#

assign motorway_modifier =
    if and avoid_motorways
           highway=motorway|motorway_link
    then 10000
    else 1.00

#
# Explicit toll avoidance
#

assign toll_modifier =
    if and avoid_toll
           toll=yes
    then 10000
    else 1.00

#
# Final cost model
#
# Curviness is represented through:
#
#   road_class_cost
#   speed_modifier
#   town_modifier
#
# Hilliness remains independent and is not yet applied.
#

assign calculated_cost =
    multiply road_class_cost
    multiply surface_modifier
    multiply speed_modifier
    multiply town_modifier
             motorway_modifier

assign costfactor =
    if not way_is_usable
    then 10000
    else if greater toll_modifier 1
    then 10000
    else min 9999 calculated_cost

#
# Priority classification
#
# Used primarily for navigation instruction generation.
#

assign priorityclassifier =
    if      is_motorway       then 30
    else if is_motorway_link  then 29
    else if is_trunk          then 28
    else if is_trunk_link     then 27
    else if is_primary        then 26
    else if is_primary_link   then 25
    else if is_secondary      then 24
    else if is_secondary_link then 23
    else if is_tertiary       then 22
    else if is_tertiary_link  then 21
    else if is_unclassified   then 20
    else if is_residential_or_living then 6
    else if is_service        then 6
    else if is_track          then 2
    else if is_road           then 2
    else 0

#
# Navigation metadata
#

assign isroundabout =
    junction=roundabout

assign isgoodforcars =
    if greater priorityclassifier 6
    then true
    else if or is_residential_or_living
               is_service
    then true
    else false

assign classifiermask =
    add          isbadoneway
    add multiply isgoodoneway   2
    add multiply isroundabout   4
    add multiply is_link        8
    add multiply isgoodforcars 16
        multiply motorcycle_access_destination 64


---context:node

#
# Node access
#
# Same precedence as way access.
#

assign default_node_access =
    not barrier=gate|bollard|lift_gate|cycle_barrier

assign general_node_access =
    switch access=
        default_node_access
        access=yes|permissive|designated|destination

assign vehicle_node_access =
    switch vehicle=
        general_node_access
        vehicle=yes|permissive|designated|destination

assign motor_vehicle_node_access =
    switch motor_vehicle=
        vehicle_node_access
        motor_vehicle=yes|permissive|designated|destination

assign motorcycle_node_access =
    switch motorcycle=
        motor_vehicle_node_access
        motorcycle=yes|permissive|designated|destination

#
# Node cost
#

assign initialcost =
    if and avoid_toll
           barrier=toll_booth
    then 1000000
    else if motorcycle_node_access
    then 0
    else 1000000
