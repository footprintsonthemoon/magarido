#
# BRouter Motorcycle – Kinematic Fast Test
#
# EXPERIMENTAL PROFILE
#
# Purpose:
#   Evaluate BRouter's KinematicModel as the time-oriented foundation
#   for motorcycle routing.
#
# Important:
#   This is NOT yet the final motorcycle model.
#
#   Phase 1 deliberately changes as little as possible compared with
#   BRouter's official car-vario profile:
#
#     - motorcycle access semantics
#     - vmax = 120 km/h
#     - paved-road motorcycle scope
#     - OsmAnd turn instructions
#
#   Physical vehicle parameters remain close to car-vario for this
#   first experiment. They will only be calibrated after the routing
#   behaviour has been validated.
#

---model:btools.router.KinematicModel


---context:global

assign validForCars = true

#
# Routing constraints
#

assign avoid_toll = false
assign avoid_motorways = false
assign allow_unpaved = false
assign allow_ferries = true

#
# Routing character
#
# 0 = Fast
# 2 = Curvy
# 3 = Very Curvy
#

assign curviness = 0

assign add_beeline = false
assign considerTurnRestrictions = true

#
# ------------------------------------------------------------
# KINEMATIC MODEL
# ------------------------------------------------------------
#
# Target speed in km/h.
#
# The effective speed is additionally limited by:
#
#   - explicit OSM maxspeed
#   - implicit road-class limits
#   - surface
#   - track type
#   - intersections and road geometry
#

assign vmax = 120

#
# Keep physical parameters close to the official BRouter
# car-vario profile during the first experiment.
#
# This allows us to isolate the effect of the KinematicModel
# and vmax before introducing motorcycle-specific physics.
#

assign recup_efficiency = 0.7
assign totalweight = 340
assign f_roll = 50
assign f_air = 0.35
assign f_recup = 400
assign p_standby = 250

#
# Turn instructions
#

assign turnInstructionMode = 3
assign turnInstructionRoundabouts = true

#
# Technical routing parameter
#

assign pass1coefficient = 1.3


---context:way

#
# Classifier constants
#

assign classifier_none = 1
assign classifier_ferry = 2

#
# Road classification
#

assign is_motorway =
    highway=motorway

assign is_motorway_link =
    highway=motorway_link

assign is_trunk =
    highway=trunk

assign is_trunk_link =
    highway=trunk_link

assign is_primary =
    highway=primary

assign is_primary_link =
    highway=primary_link

assign is_secondary =
    highway=secondary

assign is_secondary_link =
    highway=secondary_link

assign is_tertiary =
    highway=tertiary

assign is_tertiary_link =
    highway=tertiary_link

assign is_unclassified =
    highway=unclassified

assign is_residential =
    highway=residential

assign is_living =
    or highway=living_street
       living_street=yes

assign is_service =
    highway=service

assign is_track =
    highway=track

assign is_road =
    highway=road

assign is_path =
    highway=path|footway|bridleway

assign is_ferry =
    route=ferry

assign is_residential_or_living =
    or is_residential
       is_living

assign is_link =
    highway=motorway_link|trunk_link|primary_link|secondary_link|tertiary_link


#
# ------------------------------------------------------------
# MOTORCYCLE ACCESS
# ------------------------------------------------------------
#
# Precedence:
#
#   motorcycle
#     -> motor_vehicle
#       -> vehicle
#         -> access
#           -> implicit road default
#

assign default_motorcycle_access =
    switch highway=motorway|motorway_link       true
    switch highway=trunk|trunk_link             true
    switch highway=primary|primary_link         true
    switch highway=secondary|secondary_link     true
    switch highway=tertiary|tertiary_link       true
    switch highway=unclassified                 true
    switch is_residential_or_living             true
    switch highway=service                      true
    switch route=ferry                          allow_ferries
    switch and highway=track allow_unpaved      true
    switch and highway=road allow_unpaved       true
    false

assign general_access =
    switch access=
        default_motorcycle_access
        access=yes|permissive|designated|destination

assign vehicle_access =
    switch vehicle=
        general_access
        vehicle=yes|permissive|designated|destination

assign motor_vehicle_access =
    switch motor_vehicle=
        vehicle_access
        motor_vehicle=yes|permissive|designated|destination

assign motorcycle_access =
    switch motorcycle=
        motor_vehicle_access
        motorcycle=yes|permissive|designated|destination

assign motorcycle_access_destination =
    switch motorcycle=
        switch motor_vehicle=
            switch vehicle=
                access=destination
                vehicle=destination
            motor_vehicle=destination
        motorcycle=destination


#
# ------------------------------------------------------------
# ONE-WAY HANDLING
# ------------------------------------------------------------
#

assign isbadoneway =
    if reversedirection=yes
    then
        if oneway=
        then junction=roundabout
        else oneway=yes|true|1
    else
        oneway=-1

assign isgoodoneway =
    if reversedirection=yes
    then oneway=-1
    else
        if oneway=
        then junction=roundabout
        else oneway=yes|true|1

assign accessspeedlimit =
    if motorcycle_access
    then 999
    else 0

assign onewayspeedlimit =
    if isbadoneway
    then 0
    else 999


#
# ------------------------------------------------------------
# SURFACE SPEED LIMIT
# ------------------------------------------------------------
#

assign maxspeed_surface =
    switch or surface=
              surface=paved|asphalt|concrete
        999

    switch surface=paving_stones|cobblestone|sett
        30

    switch surface=fine_gravel
        switch allow_unpaved 10 0

    switch allow_unpaved
        5
        0


#
# Track limits
#

assign maxspeed_tracktype =
    switch not is_track
        999

    switch tracktype=
        20

    switch tracktype=grade1
        30

    switch tracktype=grade2
        switch allow_unpaved 20 0

    switch allow_unpaved
        10
        0


#
# ------------------------------------------------------------
# IMPLICIT SPEED LIMITS
# ------------------------------------------------------------
#
# These describe plausible maximum speeds when OSM contains no
# explicit maxspeed.
#
# vmax=120 remains the overall target-speed ceiling.
#

assign maxspeed_implicit =
    switch highway=motorway
        999

    switch highway=motorway_link
        100

    switch highway=trunk
        120

    switch highway=trunk_link
        90

    switch highway=primary|primary_link
        100

    switch highway=secondary|secondary_link
        90

    switch highway=tertiary|tertiary_link
        80

    switch highway=unclassified
        60

    switch is_residential
        50

    switch is_living
        20

    switch is_service
        30

    switch route=ferry
        10

    switch highway=track|road
        switch allow_unpaved 30 0

    0


#
# ------------------------------------------------------------
# EXPLICIT SPEED LIMITS
# ------------------------------------------------------------
#

assign maxspeed_forward =
    switch maxspeed:forward=10    10
    switch maxspeed:forward=20    20
    switch maxspeed:forward=30    30
    switch maxspeed:forward=40    40
    switch maxspeed:forward=50    50
    switch maxspeed:forward=60    60
    switch maxspeed:forward=70    70
    switch maxspeed:forward=80    80
    switch maxspeed:forward=90    90
    switch maxspeed:forward=100  100
    switch maxspeed:forward=110  110
    switch maxspeed:forward=120  120
    switch maxspeed:forward=130  130
    switch maxspeed:forward=urban 50
    switch maxspeed:forward=rural 100
    999

assign maxspeed_backward =
    switch maxspeed:backward=10    10
    switch maxspeed:backward=20    20
    switch maxspeed:backward=30    30
    switch maxspeed:backward=40    40
    switch maxspeed:backward=50    50
    switch maxspeed:backward=60    60
    switch maxspeed:backward=70    70
    switch maxspeed:backward=80    80
    switch maxspeed:backward=90    90
    switch maxspeed:backward=100  100
    switch maxspeed:backward=110  110
    switch maxspeed:backward=120  120
    switch maxspeed:backward=130  130
    switch maxspeed:backward=urban 50
    switch maxspeed:backward=rural 100
    999

assign maxspeed_explicit =
    switch maxspeed=10    10
    switch maxspeed=20    20
    switch maxspeed=30    30
    switch maxspeed=40    40
    switch maxspeed=50    50
    switch maxspeed=60    60
    switch maxspeed=70    70
    switch maxspeed=80    80
    switch maxspeed=90    90
    switch maxspeed=100  100
    switch maxspeed=110  110
    switch maxspeed=120  120
    switch maxspeed=130  130
    switch maxspeed=urban 50
    switch maxspeed=rural 100

    if reversedirection=yes
    then maxspeed_backward
    else maxspeed_forward


#
# Effective maximum speed used by KinematicModel.
#

assign maxspeed =
    min onewayspeedlimit
    min accessspeedlimit
    min maxspeed_explicit
    min maxspeed_implicit
    min maxspeed_surface
        maxspeed_tracktype


#
# ------------------------------------------------------------
# HARD CONSTRAINTS
# ------------------------------------------------------------
#

assign is_avoided_toll =
    and avoid_toll
        toll=yes

assign is_avoided_motorway =
    and avoid_motorways
        highway=motorway|motorway_link


#
# ------------------------------------------------------------
# COST FACTOR
# ------------------------------------------------------------
#
# No road-character preference yet.
#
# Normal roads add no extra BRF distance penalty.
# KinematicModel determines the route from travel dynamics.
#
# avoid_motorways is intentionally expensive rather than strictly
# impossible, following BRouter's car-vario approach. This avoids
# impossible routes where motorway access is unavoidable.
#

#
# ------------------------------------------------------------
# ROAD CHARACTER
# ------------------------------------------------------------
#
# KinematicModel already provides the time-oriented base cost.
#
# Road character therefore adds only an additional penalty.
#
# Desired motorcycle roads receive no additional cost.
# Less desirable road classes receive progressively larger costs.
#
# This is intentionally conservative for the first experiment.
#

assign motorway_character_cost =
    switch equal curviness 0 0.00
    switch equal curviness 2 0.35
    switch equal curviness 3 0.80
    0.00

assign motorway_link_character_cost =
    switch equal curviness 0 0.00
    switch equal curviness 2 0.30
    switch equal curviness 3 0.70
    0.00

assign trunk_character_cost =
    switch equal curviness 0 0.00
    switch equal curviness 2 0.20
    switch equal curviness 3 0.40
    0.00

assign trunk_link_character_cost =
    switch equal curviness 0 0.00
    switch equal curviness 2 0.15
    switch equal curviness 3 0.35
    0.00

assign primary_character_cost =
    switch equal curviness 0 0.00
    switch equal curviness 2 0.08
    switch equal curviness 3 0.15
    0.00

assign primary_link_character_cost =
    switch equal curviness 0 0.00
    switch equal curviness 2 0.08
    switch equal curviness 3 0.15
    0.00

assign secondary_character_cost = 0.00
assign secondary_link_character_cost = 0.00
assign tertiary_character_cost = 0.00
assign tertiary_link_character_cost = 0.00

assign unclassified_character_cost =
    switch equal curviness 0 0.05
    switch equal curviness 2 0.02
    switch equal curviness 3 0.00
    0.05

#
# Local roads must never become attractive merely because they are small.
#

assign residential_character_cost =
    switch equal curviness 0 0.20
    switch equal curviness 2 0.30
    switch equal curviness 3 0.40
    0.20

assign living_character_cost =
    switch equal curviness 0 0.50
    switch equal curviness 2 0.60
    switch equal curviness 3 0.75
    0.50

assign service_character_cost =
    switch equal curviness 0 0.60
    switch equal curviness 2 0.70
    switch equal curviness 3 0.85
    0.60

assign road_character_cost =
    if is_motorway
    then motorway_character_cost

    else if is_motorway_link
    then motorway_link_character_cost

    else if is_trunk
    then trunk_character_cost

    else if is_trunk_link
    then trunk_link_character_cost

    else if is_primary
    then primary_character_cost

    else if is_primary_link
    then primary_link_character_cost

    else if is_secondary
    then secondary_character_cost

    else if is_secondary_link
    then secondary_link_character_cost

    else if is_tertiary
    then tertiary_character_cost

    else if is_tertiary_link
    then tertiary_link_character_cost

    else if is_unclassified
    then unclassified_character_cost

    else if is_residential
    then residential_character_cost

    else if is_living
    then living_character_cost

    else if is_service
    then service_character_cost

    else 0.00


#
# ------------------------------------------------------------
# COST FACTOR
# ------------------------------------------------------------
#

assign costfactor =
    if equal maxspeed 0
    then 10000

    else if is_avoided_toll
    then 10000

    else if is_avoided_motorway
    then 10

    else road_character_cost


#
# Minimum-speed concept used by KinematicModel.
#

assign minspeed =
    switch highway=motorway|motorway_link|trunk
        75
        0


#
# ------------------------------------------------------------
# TURN-INSTRUCTION CLASSIFICATION
# ------------------------------------------------------------
#

assign priorityclassifier =
    if is_motorway
    then 30

    else if is_motorway_link
    then 29

    else if is_trunk
    then 28

    else if is_trunk_link
    then 27

    else if is_primary
    then 26

    else if is_primary_link
    then 25

    else if is_secondary
    then 24

    else if is_secondary_link
    then 23

    else if is_tertiary
    then 22

    else if is_tertiary_link
    then 21

    else if is_unclassified
    then 20

    else if is_residential_or_living
    then 6

    else if is_service
    then 6

    else if is_track
    then 2

    else if is_road
    then 2

    else 0

assign isroundabout =
    junction=roundabout

assign isgoodforcars =
    if greater priorityclassifier 6
    then true

    else if or is_residential_or_living
               is_service
    then true

    else false


#
# KinematicModel uses classifiermask to evaluate junctions and
# road transitions.
#

assign classifiermask =
    add          isbadoneway
    add multiply isgoodoneway   2
    add multiply isroundabout   4
    add multiply is_link        8
    add multiply isgoodforcars 16
    add multiply is_residential_or_living 32
        multiply motorcycle_access_destination 64


---context:node

#
# Motorcycle node access
#

assign default_node_access =
    not barrier=gate|bollard|lift_gate|cycle_barrier

assign general_node_access =
    switch access=
        default_node_access
        access=yes|permissive|designated|destination

assign vehicle_node_access =
    switch vehicle=
        general_node_access
        vehicle=yes|permissive|designated|destination

assign motor_vehicle_node_access =
    switch motor_vehicle=
        vehicle_node_access
        motor_vehicle=yes|permissive|designated|destination

assign motorcycle_node_access =
    switch motorcycle=
        motor_vehicle_node_access
        motorcycle=yes|permissive|designated|destination

assign initialcost =
    if and avoid_toll
           barrier=toll_booth
    then 1000000

    else if motorcycle_node_access
    then 0

    else 1000000


#
# Node speed limit.
#
# Traffic lights force a slowdown. The values follow the general
# approach used by BRouter's official car-vario profile.
#

assign maxspeed =
    if or crossing=traffic_signals
          highway=traffic_signals
    then
        switch greater way:priorityclassifier 24 5
        switch greater way:priorityclassifier 22 3
        switch greater way:priorityclassifier 20 1
        0

    else if railway=level_crossing
    then 0

    else 999
